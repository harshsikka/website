<article class="fig-row {{post_class}}">
    <a class="fig-row-link" href="{{url}}">
        <time class="fig-row-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
        <div class="fig-row-body">
            <h3 class="fig-row-title">{{title}}</h3>
            {{#if @custom.show_author}}
                <p class="fig-row-author">{{#foreach authors}}{{#if @first}}{{name}}{{else}}, {{name}}{{/if}}{{/foreach}}</p>
            {{/if}}
        </div>
    </a>
</article>
